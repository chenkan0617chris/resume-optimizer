# Optional: Dev-only Anthropic API key. Production users enter their own via the UI.
# Leave unset to require the in-app modal flow.
VITE_ANTHROPIC_API_KEY=your_api_key_here

# Optional: Override the Anthropic API base URL.
# Leave unset (default) for direct browser-to-Anthropic calls (BYO key mode).
# Set to a Cloudflare Worker URL to use a proxy (server-side key) without changing components.
# VITE_API_BASE=https://my-worker.workers.dev
